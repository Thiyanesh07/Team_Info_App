              "raw": "{\n  \"fcmToken\": \"sample-fcm-token\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/fcm-token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "fcm-token"]
            }
