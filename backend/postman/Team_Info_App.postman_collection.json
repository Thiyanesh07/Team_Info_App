    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Google Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 2xx or expected auth error', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 400, 401, 403]);",
                  "});",
                  "let json;",
                  "try { json = pm.response.json(); } catch (e) {}",
                  "if (pm.response.code === 200 && json && json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  if (pm.environment) pm.environment.set('token', json.data.token);",
                  "  if (json.data.user && json.data.user.id) {",
                  "    pm.collectionVariables.set('targetUserId', json.data.user.id);",
                  "    if (pm.environment) pm.environment.set('targetUserId', json.data.user.id);",
                  "  }",
                  "  console.log('Token saved to collection/environment variables');",
                  "} else {",
                  "  console.log('Token not saved. Response code:', pm.response.code);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"{{googleIdToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google"]
            }
          }
        },
        {
          "name": "GET Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
