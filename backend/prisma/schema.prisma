// Prisma Schema for Team Management & Productivity App

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────
// ENUMS
// ──────────────────────────────────────

enum UserRole {
  ADMIN
  CAPTAIN
  VICE_CAPTAIN
  STRATEGIST
  MANAGER
  MEMBER
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum LearningLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum LearningStatus {
  ONGOING
  COMPLETED
}

enum ActivityType {
  LEARNING
  PROJECT
  OTHERS
}

enum HackathonStatus {
  UPCOMING
  COMPLETED
}

enum SkillType {
  TECHNICAL
  NON_TECHNICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// ──────────────────────────────────────
// USERS
// ──────────────────────────────────────

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String?
  name              String
  regNo             String?
  department        String?
  year              String?
  mobile            String?
  cgpa              Float?
  rewardPoints      Int      @default(0)
  activityPoints    Int      @default(0)
  profileImageUrl   String?
  role              UserRole @default(MEMBER)
  fcmToken          String?

  // Skills
  primarySkills     String[] @default([])
  secondarySkills   String[] @default([])
  specialSkills     String[] @default([])
  programmingLangs  String[] @default([])

  // Social Links
  linkedinUrl       String?
  githubUrl         String?
  leetcodeUrl       String?
  twitterUrl        String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  personalProjects  PersonalProject[]
  teamMemberships   TeamProjectMember[]
  projectUpdates    ProjectUpdate[]
  hackathons        Hackathon[]
  learnings         Learning[]
  dailyActivities   DailyActivity[]
  certifications    Certification[]
  psSkills          PsSkill[]
  sentTeamMessages  TeamMessage[]
  chatParticipants  ChatParticipant[]
  chatMessages      ChatMessage[]
  createdTeamProjects TeamProject[] @relation("CreatedBy")
  captainedProjects   TeamProject[] @relation("AssignedCaptain")
  tasksAssigned     TaskAssignment[] @relation("TasksAssigned")
  tasksReceived     TaskAssignment[] @relation("TasksReceived")
  taskReports       TaskReport[]

  @@map("users")
}

// ──────────────────────────────────────
// PERSONAL PROJECTS
// ──────────────────────────────────────

model PersonalProject {
  id            String   @id @default(uuid())
  userId        String
  name          String
  description   String?
  contribution  String?
  githubLink    String?
  liveLink      String?
  skillsUsed    String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("personal_projects")
}

// ──────────────────────────────────────
// TEAM PROJECTS
// ──────────────────────────────────────

model TeamProject {
  id               String        @id @default(uuid())
  projectName      String
  createdById      String
  assignedCaptainId String?
  domain           String?
  subDomain        String?
  problemStatement String?
  solution         String?
  startDate        DateTime?
  status           ProjectStatus @default(NOT_STARTED)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  createdBy        User          @relation("CreatedBy", fields: [createdById], references: [id])
  assignedCaptain  User?         @relation("AssignedCaptain", fields: [assignedCaptainId], references: [id])
  members          TeamProjectMember[]
  updates          ProjectUpdate[]

  @@map("team_projects")
}

model TeamProjectMember {
  id          String      @id @default(uuid())
  teamProjectId String
  userId      String
  joinedAt    DateTime    @default(now())

  teamProject TeamProject @relation(fields: [teamProjectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamProjectId, userId])
  @@map("team_project_members")
}

// ──────────────────────────────────────
// PROJECT UPDATES
// ──────────────────────────────────────

model ProjectUpdate {
  id          String      @id @default(uuid())
  projectId   String
  userId      String
  updateText  String
  createdAt   DateTime    @default(now())

  project     TeamProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("project_updates")
}

// ──────────────────────────────────────
// HACKATHONS
// ──────────────────────────────────────

model Hackathon {
  id            String          @id @default(uuid())
  userId        String
  hackName      String
  projectName   String?
  description   String?
  contribution  String?
  skillsUsed    String[]        @default([])
  date          DateTime?
  isTeam        Boolean         @default(false)
  teamMembers   String[]        @default([])
  status        HackathonStatus @default(UPCOMING)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds        HackathonRound[]

  @@map("hackathons")
}

model HackathonRound {
  id            String    @id @default(uuid())
  hackathonId   String
  roundName     String
  description   String?

  hackathon     Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@map("hackathon_rounds")
}

// ──────────────────────────────────────
// LEARNING
// ──────────────────────────────────────

model Learning {
  id          String         @id @default(uuid())
  userId      String
  skillName   String
  topics      String[]       @default([])
  startDate   DateTime?
  endDate     DateTime?
  level       LearningLevel  @default(BEGINNER)
  status      LearningStatus @default(ONGOING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learnings")
}

// ──────────────────────────────────────
// DAILY ACTIVITY
// ──────────────────────────────────────

model DailyActivity {
  id          String       @id @default(uuid())
  userId      String
  type        ActivityType
  customType  String?
  description String?
  startTime   DateTime
  endTime     DateTime
  date        DateTime
  createdAt   DateTime     @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("daily_activities")
}

// ──────────────────────────────────────
// TASK ASSIGNMENTS
// ──────────────────────────────────────

model TaskAssignment {
  id            String       @id @default(uuid())
  title         String
  description   String?
  assignedById  String
  assignedToId  String
  deadline      DateTime?
  priority      TaskPriority @default(MEDIUM)
  status        TaskStatus   @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assignedBy    User         @relation("TasksAssigned", fields: [assignedById], references: [id])
  assignedTo    User         @relation("TasksReceived", fields: [assignedToId], references: [id])
  reports       TaskReport[]

  @@map("task_assignments")
}

model TaskReport {
  id          String         @id @default(uuid())
  taskId      String
  userId      String
  reportText  String
  createdAt   DateTime       @default(now())

  task        TaskAssignment @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_reports")
}

// ──────────────────────────────────────
// CERTIFICATIONS
// ──────────────────────────────────────

model Certification {
  id          String   @id @default(uuid())
  userId      String
  skill       String
  provider    String?
  description String?
  issuedDate  DateTime?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

// ──────────────────────────────────────
// PS SKILLS
// ──────────────────────────────────────

model PsSkill {
  id          String    @id @default(uuid())
  userId      String
  type        SkillType
  skillName   String
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ps_skills")
}

// ──────────────────────────────────────
// TEAM MESSAGES (Group Chat)
// ──────────────────────────────────────

model TeamMessage {
  id          String   @id @default(uuid())
  senderId    String
  message     String?
  imageUrl    String?
  isPinned    Boolean  @default(false)
  timestamp   DateTime @default(now())

  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("team_messages")
}

// ──────────────────────────────────────
// PERSONAL MESSAGES (1-to-1 Chat)
// ──────────────────────────────────────

model ChatConversation {
  id           String            @id @default(uuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@map("chat_conversations")
}

model ChatParticipant {
  id              String           @id @default(uuid())
  conversationId  String
  userId          String

  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id              String           @id @default(uuid())
  conversationId  String
  senderId        String
  message         String?
  imageUrl        String?
  timestamp       DateTime         @default(now())

  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
