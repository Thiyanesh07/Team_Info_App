generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  password            String?
  name                String
  regNo               String?
  department          String?
  year                String?
  mobile              String?
  cgpa                Float?
  rewardPoints        Int                 @default(0)
  activityPoints      Int                 @default(0)
  psToken             String?
  groupPoints         Int?
  contributionPercent Float?
  profileImageUrl     String?
  role                UserRole            @default(MEMBER)
  fcmToken            String?
  primarySkills       String[]            @default([])
  secondarySkills     String[]            @default([])
  specialSkills       String[]            @default([])
  programmingLangs    String[]            @default([])
  linkedinUrl         String?
  githubUrl           String?
  leetcodeUrl         String?
  twitterUrl          String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  lastActive          DateTime            @default(now())
  certifications      Certification[]
  chatMessages        ChatMessage[]
  chatParticipants    ChatParticipant[]
  dailyActivities     DailyActivity[]
  hackathons          Hackathon[]
  learnings           Learning[]
  personalProjects    PersonalProject[]
  projectUpdates      ProjectUpdate[]
  psSkills            PsSkill[]
  systemActivities    SystemActivity[]
  tasksAssigned       TaskAssignment[]    @relation("TasksAssigned")
  tasksReceived       TaskAssignment[]    @relation("TasksReceived")
  taskReports         TaskReport[]
  sentTeamMessages    TeamMessage[]
  teamMemberships     TeamProjectMember[]
  captainedProjects   TeamProject[]       @relation("AssignedCaptain")
  createdTeamProjects TeamProject[]       @relation("CreatedBy")
  reportsAssignedBy   ReportRequest[]     @relation("ReportsAssignedBy")
  reportSubmissions   ReportSubmission[]

  @@map("users")
}

model PersonalProject {
  id           String   @id @default(uuid())
  userId       String
  name         String
  description  String?
  contribution String?
  githubLink   String?
  liveLink     String?
  skillsUsed   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("personal_projects")
}

model TeamProject {
  id                String              @id @default(uuid())
  projectName       String
  createdById       String
  assignedCaptainId String?
  domain            String?
  subDomain         String?
  problemStatement  String?
  solution          String?
  startDate         DateTime?
  status            ProjectStatus       @default(NOT_STARTED)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  milestones        ProjectMilestone[]
  updates           ProjectUpdate[]
  members           TeamProjectMember[]
  assignedCaptain   User?               @relation("AssignedCaptain", fields: [assignedCaptainId], references: [id])
  createdBy         User                @relation("CreatedBy", fields: [createdById], references: [id])

  @@map("team_projects")
}

model ProjectMilestone {
  id          String      @id @default(uuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  status      String      @default("PENDING")
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     TeamProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_milestones")
}

model TeamProjectMember {
  id            String      @id @default(uuid())
  teamProjectId String
  userId        String
  joinedAt      DateTime    @default(now())
  teamProject   TeamProject @relation(fields: [teamProjectId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamProjectId, userId])
  @@map("team_project_members")
}

model ProjectUpdate {
  id          String      @id @default(uuid())
  projectId   String
  userId      String
  createdAt   DateTime    @default(now())
  date        DateTime    @default(now())
  description String?
  title       String
  project     TeamProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@map("project_updates")
}

model Hackathon {
  id           String           @id @default(uuid())
  userId       String
  hackName     String
  projectName  String?
  description  String?
  contribution String?
  skillsUsed   String[]         @default([])
  date         DateTime?
  isTeam       Boolean          @default(false)
  teamMembers  String[]         @default([])
  status       HackathonStatus  @default(UPCOMING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  rounds       HackathonRound[]
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("hackathons")
}

model HackathonRound {
  id          String    @id @default(uuid())
  hackathonId String
  roundName   String
  description String?
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)

  @@map("hackathon_rounds")
}

model Learning {
  id        String         @id @default(uuid())
  userId    String
  skillName String
  topics    String[]       @default([])
  startDate DateTime?
  endDate   DateTime?
  level     LearningLevel  @default(BEGINNER)
  status    LearningStatus @default(ONGOING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("learnings")
}

model DailyActivity {
  id          String       @id @default(uuid())
  userId      String
  type        ActivityType
  customType  String?
  description String?
  startTime   DateTime
  endTime     DateTime
  date        DateTime
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@map("daily_activities")
}

model TaskAssignment {
  id           String       @id @default(uuid())
  title        String
  description  String?
  assignedById String
  assignedToId String
  deadline     DateTime?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedBy   User         @relation("TasksAssigned", fields: [assignedById], references: [id])
  assignedTo   User         @relation("TasksReceived", fields: [assignedToId], references: [id])
  reports      TaskReport[]

  @@index([assignedById])
  @@index([assignedToId])
  @@map("task_assignments")
}

model TaskReport {
  id         String         @id @default(uuid())
  taskId     String
  userId     String
  reportText String
  createdAt  DateTime       @default(now())
  task       TaskAssignment @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_reports")
}

model Certification {
  id          String    @id @default(uuid())
  userId      String
  skill       String
  provider    String?
  description String?
  issuedDate  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("certifications")
}

model PsSkill {
  id        String    @id @default(uuid())
  userId    String
  type      SkillType
  skillName String
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("ps_skills")
}

model TeamMessage {
  id        String   @id @default(uuid())
  senderId  String
  message   String?
  imageUrl  String?
  isPinned  Boolean  @default(false)
  timestamp DateTime @default(now())
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("team_messages")
}

model ChatConversation {
  id           String            @id @default(uuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     ChatMessage[]
  participants ChatParticipant[]

  @@map("chat_conversations")
}

model ChatParticipant {
  id             String           @id @default(uuid())
  conversationId String
  userId         String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  senderId       String
  message        String?
  imageUrl       String?
  timestamp      DateTime         @default(now())
  isPinned       Boolean          @default(false)
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model SystemActivity {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("system_activities")
}

enum UserRole {
  ADMIN
  CAPTAIN
  VICE_CAPTAIN
  STRATEGIST
  MANAGER
  MEMBER
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum LearningLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum LearningStatus {
  ONGOING
  COMPLETED
}

enum ActivityType {
  LEARNING
  PROJECT
  OTHERS
}

enum HackathonStatus {
  UPCOMING
  COMPLETED
}

enum SkillType {
  TECHNICAL
  NON_TECHNICAL
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}
enum ReportAudience {
  INDIVIDUAL
  ROLE
  TEAM
}

enum ReportSubmissionStatus {
  PENDING
  COMPLETED
  REDO
}

model ReportRequest {
  id              String           @id @default(uuid())
  title           String
  description     String?
  deadline        DateTime?
  assignedById    String
  targetAudience  ReportAudience   @default(TEAM)
  targetRoles     UserRole[]       @default([])
  targetUserIds   String[]         @default([])
  allowedFormats  String[]         @default([".pdf", ".docx", ".xlsx", ".pptx"])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assignedBy      User             @relation("ReportsAssignedBy", fields: [assignedById], references: [id])
  submissions     ReportSubmission[]

  @@map("report_requests")
}

model ReportSubmission {
  id              String                 @id @default(uuid())
  reportRequestId String
  userId          String
  fileUrl         String
  notes           String?
  status          ReportSubmissionStatus @default(PENDING)
  reviewerNotes   String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  reportRequest   ReportRequest          @relation(fields: [reportRequestId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportRequestId, userId])
  @@map("report_submissions")
}
